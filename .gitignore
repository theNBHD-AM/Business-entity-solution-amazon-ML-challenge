# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Data & Large Artifacts (Strictly exclude large datasets and vectors)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/artifacts/*
!data/artifacts/.gitkeep
outputs/*
!outputs/.gitkeep

# Large binary files
*.npy
*.parquet
*.faiss
*.tsv
*.csv
*.tar.gz
*.zip

# Logs
logs/
*.log

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
